# Immich base URL — NO /api suffix.
IMMICH_URL=http://NAS_IP:2283
# Immich → Account Settings → API Keys. Give it all permissions.
IMMICH_API_KEY=
# Optional:
# Where your browser reaches Immich, for "Open in Immich" links (default: IMMICH_URL)
# IMMICH_PUBLIC_URL=https://photos.example.com
# UPLOAD_CONCURRENCY=2
# HISTORY_LIMIT=50
